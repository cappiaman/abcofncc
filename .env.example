# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite / React)
# ==============================================================================
VITE_SUPABASE_URL=https://pltksqddqehpxrlvuqzv.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# SUPABASE EDGE FUNCTIONS ENVIRONMENT SECRETS
# Set these via Supabase CLI: supabase secrets set KEY=VALUE
# ==============================================================================
# 1. Google Gemini Vision API Key (Get from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# 2. Google Cloud Service Account JSON Key (single-line JSON string)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-gcp-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-gcp-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# 3. Supabase internal credentials
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_URL=https://pltksqddqehpxrlvuqzv.supabase.co
